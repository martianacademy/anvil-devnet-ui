{
  "name": "anvil-devnet-ui",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${DEVNET_API_PORT:-3010}",
    "build": "next build",
    "start": "next start -p ${DEVNET_API_PORT:-3010}",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "check": "bun run typecheck && bun run lint && bun run test",
    "db:reset": "bun scripts/resetDb.ts",
    "build:mock-erc20": "bun scripts/buildMockErc20.ts",
    "smoke": "next build && node --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "viem": "^2.47.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "description": "Headless Anvil control plane for the Blockscout devnet explorer"
}
