# The explorer UI: Blockscout's frontend with this project's DevNet pages.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  THIS IMAGE MUST NOT BE PUBLISHED.                                      │
# │                                                                         │
# │  It contains a Derivative Work of Blockscout. Blockscout's licence      │
# │  (LicenseRef-Blockscout §4) permits creating one for your own use, and  │
# │  forbids distributing it to third parties without a commercial licence  │
# │  from Blockscout. Build it locally; do not push it to a registry.       │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Building here rather than on the host is what removes pnpm and Node from the
# requirements — Docker is enough.
#
# Build from the repository root:
#   docker build -f stack/Dockerfile.explorer -t anvil-devnet-ui:local .

# ── fetch and patch Blockscout's frontend ────────────────────────────────────
FROM node:22-slim AS source
WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pinned, because upstream.patch is a diff against this exact tree — tracking
# `main` would break the build the first time Blockscout touched a patched file.
# Bump deliberately, then regenerate the patch against the new commit.
ARG BLOCKSCOUT_FRONTEND_REF=62343f1f36185eb350bebf13866d16b46fb13775
RUN git init -q . \
    && git remote add origin https://github.com/blockscout/frontend.git \
    && git fetch --depth 1 origin "${BLOCKSCOUT_FRONTEND_REF}" \
    && git checkout -q FETCH_HEAD \
    # `pnpm build` reads the version from git describe, which a shallow clone
    # cannot answer without a tag.
    && git tag devnet-fork-base

# Our own code first, then the handful of upstream edits.
COPY stack/explorer-overlay/src/. ./src/
COPY stack/explorer-overlay/upstream.patch /tmp/upstream.patch
RUN git apply /tmp/upstream.patch && rm /tmp/upstream.patch

# ── install and build ────────────────────────────────────────────────────────
FROM node:22-slim AS build
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

COPY --from=source /src ./

# Blockscout's frontend pulls ~2,900 packages. On a slow or flaky link the
# default fetch timeout kills the build near the end, after twenty minutes of
# downloading, so give it real retries and keep fewer sockets in flight — the
# contention is what starves individual downloads on a weak connection.
#
# The store is a cache mount: a failed build no longer starts from zero.
#
# --ignore-scripts: a transitive WebRTC dependency compiles native code and needs
# a toolchain it never uses at runtime.
# Set through the environment rather than `pnpm config set --global`, which
# refuses to run until pnpm's global bin directory is on PATH.
ENV npm_config_store_dir=/pnpm-store \
    npm_config_fetch_retries=10 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=300000 \
    npm_config_fetch_timeout=600000 \
    npm_config_network_concurrency=4
RUN --mount=type=cache,target=/pnpm-store,sharing=locked \
    pnpm install --ignore-scripts --frozen-lockfile

ENV NEXT_TELEMETRY_DISABLED=1

# `pnpm build` is only `next build`. The icon sprite is generated, not committed
# (public/icons holds a single .d.ts), so building without this ships an explorer
# with no icons at all. Blockscout's own build:next also downloads external asset
# configs — skipped here, since a local devnet has no marketplace or branding to
# fetch and it would make the image build depend on a third-party host.
# Blockscout's own Dockerfile raises the heap to 8 GB for this build; it OOMs at
# Node's default. Kept a little lower so it fits a stock Docker Desktop (which
# hands out about 8 GB in total) — raise it if your machine has room.
ARG NODE_HEAP_MB=6144
ENV NODE_OPTIONS="--max-old-space-size=${NODE_HEAP_MB}"

# routes:generate rewrites the typed route map. The committed one does not know
# about the /devnet pages this overlay adds, and several upstream files are typed
# as a Record over every route.
RUN pnpm svg:build-sprite \
    && pnpm routes:generate \
    && pnpm run build

# ── runtime ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

COPY --from=build /app ./

# Blockscout hands the browser its configuration through window.__envs, written
# at container start from the NEXT_PUBLIC_* environment. Without this the app
# boots with no API host, no chain and no features — `next start` alone is not
# enough. The rest of Blockscout's entrypoint (asset downloads, favicon and OG
# image generation, sitemaps) is for a public deployment and is skipped.
COPY --from=build /app/deploy/scripts/make_envs_script.sh /usr/local/bin/write-envs.sh

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=10 \
  CMD curl -fsS http://127.0.0.1:3000/ || exit 1

CMD ["sh", "-c", "/usr/local/bin/write-envs.sh ./public/assets/envs.js && exec node_modules/.bin/next start -p ${PORT}"]
