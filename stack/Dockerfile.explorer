# The explorer UI: Blockscout's frontend with this project's DevNet pages.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  THIS IMAGE MUST NOT BE PUBLISHED.                                      │
# │                                                                         │
# │  It contains a Derivative Work of Blockscout. Blockscout's licence      │
# │  (LicenseRef-Blockscout §4) permits creating one for your own use, and  │
# │  forbids distributing it to third parties without a commercial licence  │
# │  from Blockscout. Build it locally; do not push it to a registry.       │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Building here rather than on the host is what removes pnpm and Node from the
# requirements — Docker is enough.
#
# Build from the repository root:
#   docker build -f stack/Dockerfile.explorer -t anvil-devnet-ui:local .

# ── fetch and patch Blockscout's frontend ────────────────────────────────────
FROM node:22-slim AS source
WORKDIR /src

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Pinned, because upstream.patch is a diff against this exact tree — tracking
# `main` would break the build the first time Blockscout touched a patched file.
# Bump deliberately, then regenerate the patch against the new commit.
ARG BLOCKSCOUT_FRONTEND_REF=62343f1f36185eb350bebf13866d16b46fb13775
RUN git init -q . \
    && git remote add origin https://github.com/blockscout/frontend.git \
    && git fetch --depth 1 origin "${BLOCKSCOUT_FRONTEND_REF}" \
    && git checkout -q FETCH_HEAD \
    # `pnpm build` reads the version from git describe, which a shallow clone
    # cannot answer without a tag.
    && git tag devnet-fork-base

# Our own code first, then the handful of upstream edits.
COPY stack/explorer-overlay/src/. ./src/
COPY stack/explorer-overlay/upstream.patch /tmp/upstream.patch
RUN git apply /tmp/upstream.patch && rm /tmp/upstream.patch

# ── install and build ────────────────────────────────────────────────────────
FROM node:22-slim AS build
WORKDIR /app

# The toolchain is here so the WebRTC dependency's native binding can actually
# be built. On macOS that needs Xcode's command line tools, which is why the
# from-source path installs with --ignore-scripts — but skipping the build leaves
# a module that throws MODULE_NOT_FOUND the moment `next build` evaluates a page
# that reaches it, and the build dies collecting page data. In a Debian image
# there is no reason not to just compile it.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       git ca-certificates build-essential python3 cmake pkg-config jq \
    && rm -rf /var/lib/apt/lists/* \
    && corepack enable

COPY --from=source /src ./

# Blockscout's frontend pulls ~2,900 packages. On a slow or flaky link the
# default fetch timeout kills the build near the end, after twenty minutes of
# downloading, so give it real retries and keep fewer sockets in flight — the
# contention is what starves individual downloads on a weak connection.
#
# The store is a cache mount: a failed build no longer starts from zero.
#
# --ignore-scripts: a transitive WebRTC dependency compiles native code and needs
# a toolchain it never uses at runtime.
# Set through the environment rather than `pnpm config set --global`, which
# refuses to run until pnpm's global bin directory is on PATH.
ENV npm_config_store_dir=/pnpm-store \
    npm_config_fetch_retries=10 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=300000 \
    npm_config_fetch_timeout=600000 \
    npm_config_network_concurrency=4
RUN --mount=type=cache,target=/pnpm-store,sharing=locked \
    pnpm install --frozen-lockfile

# Blockscout's postinstall is Chakra's typegen, so with install scripts enabled
# this has already run. Repeating it is cheap and keeps the dependency visible:
# without those types every recipe variant the theme defines — status="warning_table",
# variant="header" and friends — is unknown to TypeScript and the build fails
# typechecking on upstream's own code.
RUN pnpm chakra:typegen

ENV NEXT_TELEMETRY_DISABLED=1

# `pnpm build` is only `next build`. The icon sprite is generated, not committed
# (public/icons holds a single .d.ts), so building without this ships an explorer
# with no icons at all. Blockscout's own build:next also downloads external asset
# configs — skipped here, since a local devnet has no marketplace or branding to
# fetch and it would make the image build depend on a third-party host.
# Blockscout's own Dockerfile raises the heap to 8 GB; at Node's default this
# build dies with SIGABRT. Most of the work is Turbopack's, whose memory is
# native rather than V8 heap, so the number here mainly has to leave the VM room
# — 6 GB got the whole container OOM-killed on a stock 8 GB Docker Desktop.
# Raise it with --build-arg NODE_HEAP_MB=8192 if Docker has more to give.
ARG NODE_HEAP_MB=4096
ENV NODE_OPTIONS="--max-old-space-size=${NODE_HEAP_MB}"

# routes:generate rewrites the typed route map. The committed one does not know
# about the /devnet pages this overlay adds, and several upstream files are typed
# as a Record over every route.
# Bundler choice is a memory trade-off, not a preference. Blockscout builds with
# Turbopack, which is faster but allocates natively and outside V8's control —
# on an 8 GB Docker Desktop it gets the whole container OOM-killed regardless of
# the heap above. Webpack is slower and stays inside the budget. Pass
# --build-arg NEXT_BUNDLER=turbopack on a roomier machine.
# Next fans page-data collection out to one worker per CPU — fifteen here, each
# free to take the heap above. That is what finally exhausts the VM, after the
# bundle has already compiled. There is no environment variable for it, so the
# knob has to be written into the config; the build fails loudly if upstream ever
# moves the anchor, rather than quietly going back to fifteen.
ARG NEXT_BUILD_CPUS=2
ENV NEXT_BUILD_CPUS=${NEXT_BUILD_CPUS}
RUN node -e "\
const fs = require('fs'); \
const file = 'next.config.js'; \
const source = fs.readFileSync(file, 'utf8'); \
const anchor = 'experimental: {'; \
if (!source.includes(anchor)) { throw new Error('next.config.js has no experimental block to cap cpus in'); } \
fs.writeFileSync(file, source.replace(anchor, anchor + '\n    cpus: Number(process.env.NEXT_BUILD_CPUS) || 2,')); \
"

ARG NEXT_BUNDLER=webpack
# build_sprite.sh ends with `export NEXT_PUBLIC_ICON_SPRITE_HASH=...`, and the
# sprite is written to sprite.<hash>.svg. Running it as a subprocess loses that
# export, the app falls back to /icons/sprite.svg, and every icon in the explorer
# 404s — no logo, no menu button, no nav icons. Upstream sources it with `set -a`
# for exactly this reason, so do the same, in the same shell as the build.
RUN bash -c 'set -a \
    && source ./deploy/scripts/build_sprite.sh \
    && set +a \
    && pnpm routes:generate \
    && if [ "$NEXT_BUNDLER" = "webpack" ]; then pnpm exec next build --webpack; else pnpm run build; fi'

# ── runtime ──────────────────────────────────────────────────────────────────
FROM node:22-slim AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Blockscout's next.config sets output: "standalone", which emits a server with
# only the modules it actually reaches. Copying the whole build stage instead
# would drag in 2.7 GB of node_modules and the C++ toolchain for a 639 MB app.
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public

# Blockscout hands the browser its configuration through window.__envs, written
# at container start from the NEXT_PUBLIC_* environment. Without this the app
# boots with no API host, no chain and no features. The rest of Blockscout's
# entrypoint (asset downloads, favicon and OG image generation, sitemaps) is for
# a public deployment and is skipped.
COPY --from=build /app/deploy/scripts/make_envs_script.sh /usr/local/bin/write-envs.sh

# The sprite is written as sprite.<hash>.svg and the app asks for whatever
# NEXT_PUBLIC_ICON_SPRITE_HASH says — read at runtime, not baked into the bundle.
# Upstream carries the value from build to runtime through a .env file; deriving
# it from the file that is actually present cannot drift out of step. Without it
# every icon 404s and the explorer renders with no logo, menu button or nav icons.
RUN printf '%s\n' \
  '#!/bin/sh' \
  'set -e' \
  'sprite=$(ls public/icons/sprite.*.svg 2>/dev/null | head -1)' \
  'if [ -n "$sprite" ]; then' \
  '  NEXT_PUBLIC_ICON_SPRITE_HASH=$(basename "$sprite" .svg | cut -d. -f2)' \
  '  export NEXT_PUBLIC_ICON_SPRITE_HASH' \
  'fi' \
  '/usr/local/bin/write-envs.sh ./public/assets/envs.js' \
  'exec node server.js' \
  > /usr/local/bin/start-explorer.sh \
  && chmod +x /usr/local/bin/start-explorer.sh

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=10 \
  CMD curl -fsS http://127.0.0.1:3000/ || exit 1

# `next start` refuses to run against a standalone build; server.js is the entry.
CMD ["/usr/local/bin/start-explorer.sh"]
